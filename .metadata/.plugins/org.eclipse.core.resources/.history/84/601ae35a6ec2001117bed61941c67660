package non_primitive_example2;

public class App {
   public static void main(String args[]) {
	   //upcasting
	   Vehicle v=new Car();
	   System.out.println("v.brand");
	   v.start();
	   
	   //downcasting
	   Car c=(Car) v;
	   System.out.println(c.brand);
	   System.out.println(c.type);
	   c.start();
	   c.shiftrGear();
   }
}
